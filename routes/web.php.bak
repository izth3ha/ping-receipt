<?php

use App\Http\Controllers\SendMessageController;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Route;

Route::get('/', function () {
    $currentYear = now()->year;
    $latestReceipt = App\Models\Receipt::where('year', $currentYear)->orderBy('transaction_number', 'desc')->first();
    $nextTransactionNumber = $latestReceipt ? $latestReceipt->transaction_number + 1 : 1;
    
    return view('app', [
        'timestamp' => now()->format('m/d/y h:i A'),
        'transaction' => $currentYear . '-' . str_pad($nextTransactionNumber, 6, '0', STR_PAD_LEFT),
    ]);
});

Route::post('/send-message', SendMessageController::class)
    ->name('send-message')
    ->middleware('throttle:10,1');